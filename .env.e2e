# E2Eテスト専用環境変数
# サンプルデータを使用するため、microCMS設定は不要

# サイト設定（E2Eテスト用）
NEXT_PUBLIC_SITE_TITLE=E2Eテスト用ブログ

# テスト用のGoogle Analytics ID
NEXT_PUBLIC_GA_ID=G-TEST123456789

# テスト用のGoogle AdSense設定
NEXT_PUBLIC_ADSENSE_ID=ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_ARTICLE_SLOT=1111111111
NEXT_PUBLIC_ADSENSE_FOOTER_SLOT=2222222222

# デバッグモード（テスト広告表示）
NEXT_PUBLIC_DEBUG_MODE=true