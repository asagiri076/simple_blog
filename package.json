{
  "name": "simple_blog",
  "version": "1.0.0",
  "description": "simple blog using next",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev",
    "fetch-data": "tsx scripts/content-data/fetch-content-data.ts",
    "build": "npm run fetch-data && next build && npm run setup-assets",
    "dev-build": "next build && BUILD_MODE=development npm run setup-assets",
    "dev-server": "npx http-server out -p 3001 -c-1",
    "setup-assets": "tsx scripts/static-files/setup-static-files.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "lint": "next lint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@next/third-parties": "^15.3.4",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.2.6",
    "next": "^15.3.3",
    "postcss": "^8.5.4",
    "prismjs": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.8"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.6",
    "@vitest/ui": "^3.2.4",
    "dotenv": "^16.6.1",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.4",
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
